{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/socket.io/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "FRONTEND_URLS": "http://localhost:3000,https://frontend-*.vercel.app,https://frontend-yoondoyoungs-projects.vercel.app,https://frontend-qze7536g2-yoondoyoungs-projects.vercel.app"
  }
}
